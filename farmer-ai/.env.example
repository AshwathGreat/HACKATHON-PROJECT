# Copy this file to .env and fill in real values. Never commit .env itself.

# ---- WhatsApp Cloud API (Phase 4+) ----
WHATSAPP_TOKEN=your_meta_temporary_or_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_you_invent
WHATSAPP_APP_SECRET=your_meta_app_secret

# ---- Model ----
MODEL_PATH=model/model.pt
MODEL_CONFIDENCE_THRESHOLD=0.55

# ---- Server ----
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=https://your-ngrok-or-deployed-url.example.com

# ---- Database (Phase 7, optional) ----
DATABASE_URL=postgresql://user:password@localhost:5432/farmer_ai
